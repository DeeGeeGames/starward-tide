{
	"name": "galaxy-conquest",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "bun --port 3000 index.html",
		"typecheck": "tsc --noEmit",
		"build": "bun run typecheck && bun run scripts/build.ts",
		"check": "bun run lint && bun test && bun run build",
		"lint": "eslint src --ext .ts,.tsx"
	},
	"dependencies": {
		"ecspresso": "0.24.1",
		"idb": "^8.0.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.14",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint": "^10.8.1",
		"globals": "^17.11.0",
		"typescript": "^6.0.3"
	}
}
